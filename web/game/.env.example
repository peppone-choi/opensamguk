# web/game 환경변수 예시 — .env.local로 복사해 사용 (배포 시 compose/서버 env로 주입)

# web/gateway 내부 주소(서버 전용) — /api/game/** rewrite 대상(next.config.mjs). #516 §5로 web/game은
# 더 이상 game-api에 직접 프록시하지 않는다; 실제 서버 선택/Bearer 부착은 web/gateway가 전담한다.
# NEXT_PUBLIC_ 아님 → 브라우저 노출 금지. docker/nginx 경로(nginx가 /api/game/를 web-gateway로 보냄)에서는
# 이 값이 쓰이지 않는다 — nginx 없이 `pnpm dev`만 단독 실행할 때만 rewrite가 이 값을 쓴다.
GATEWAY_WEB_URL=http://localhost:3000

# gateway-api 주소 (서버 전용 — /api/auth/me가 사용. NEXT_PUBLIC_ 아님)
GATEWAY_API_URL=http://localhost:8080

# 게이트웨이 프론트(web/gateway) ORIGIN — 로그인 페이지가 게이트웨이에만 있으므로
# 미인증 시 크로스-앱 리다이렉트 대상 (브라우저 노출 → NEXT_PUBLIC_)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# 프로덕션에서는 NODE_ENV=production. 모든 game-api 트래픽은 동일출처 /api/game → web/gateway 프록시를
# 통과하므로 브라우저는 game-api ORIGIN을 직접 알 필요가 없다(JWT는 서버사이드 쿠키에서만 읽힘).
# 예) 배포:
#   GATEWAY_WEB_URL=http://web-gateway:3000
#   GATEWAY_API_URL=http://gateway-api:8080
#   NEXT_PUBLIC_GATEWAY_URL=https://sam.peppone.dev
