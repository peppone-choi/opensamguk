# web/gateway 환경변수 예시 — .env.local로 복사해 사용 (배포 시 compose/서버 env로 주입)

# gateway-api 주소 (서버 전용, route handler가 프록시. NEXT_PUBLIC_ 아님 — 브라우저 노출 금지)
GATEWAY_API_URL=http://localhost:8080

# game-api 주소(서버 전용) — /api/game/** 프록시가 쓰는 기본/호환 origin. #516 §5로 web/gateway가
# dev/prod 공통 유일한 game-api 프록시가 됐다. servers.json(config/servers.json)이 빈 배열일 때만
# 쓰이는 compatibility fallback (web/gateway/lib/serverRegistry.ts resolveSelectedGameApiOrigin).
GAME_API_ORIGIN=http://localhost:8081

# 기본 서버 ID(서버 전용, 공개 placeholder) — servers.json 이 빈 배열일 때 GAME_API_ORIGIN 을 이 서버에 묶는다.
# web/game 의 SERVER_ID 와 같은 값을 쓴다.
SERVER_ID=pep

# 게임 서버 프론트(web/game) 진입 URL — 로비 '입장' 링크 + 맵 프리뷰 기준.
# 게이트웨이와 출처가 다르면(로컬 :3000 / :3001) 로그인 뒤 `?next=<이 출처의 전체 주소>` 를 받는 유일한 출처이기도 하다.
NEXT_PUBLIC_GAME_URL=http://localhost:3001

# 프로덕션에서는 NODE_ENV=production → 쿠키 secure 플래그 on
# 예) 배포: GATEWAY_API_URL=http://gateway-api:8080  GAME_API_ORIGIN=http://game-api:8081
#           NEXT_PUBLIC_GAME_URL=https://sam.peppone.dev
