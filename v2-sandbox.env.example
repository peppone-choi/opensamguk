# opensamguk — v2 SANDBOX 스택 env 예시 (OPENSAM-35 / 0A-e)
#
#   cp v2-sandbox.env.example .env.v2-sandbox
#   # 값 채운 뒤
#   docker compose --env-file .env.v2-sandbox -f docker-compose.v2-sandbox.yml up -d
#
# 이 파일은 `docker-compose.v2-sandbox.yml`이 실제로 참조하는 변수 **전수**다
# (`grep -o '\${[A-Za-z_][A-Za-z0-9_]*' docker-compose.v2-sandbox.yml`로 추출).
# v1의 `.env.example`은 건드리지 않는다 — v2 스택은 별도 파일이 정본이다(계획 §2 C1).
#
# 파일명이 `.env.v2-sandbox.example`이 아닌 이유: `scripts/agent/protect-sensitive-files.sh:103-105`가
# `.env.*` 기본이름을 2개 allowlist 외에는 전부 차단한다. 가드를 약화시키는 대신 이름을 바꿨다.
#
# **여기에 실제 시크릿을 적지 말 것.** 전부 placeholder다. 실값은 gitignore되는 `.env.v2-sandbox`에.

# =====================================================================
# 1. 필수 — 미설정이면 compose가 아예 뜨지 않는다 (`:?` fail-closed)
# =====================================================================

# v2 시나리오 코드. `scenario_<숫자>` 정규형만 허용된다(ScenarioSeedRunner.kt:150).
# 상속 금지 이유: v1 코드를 물려받으면 ignoreDefaultEvents=false가 되어 v1 기본 이벤트 12행이
# 조용히 v2 DB에 적재되는데 부팅·시드·헬스체크는 전부 성공한다(계획 §0.2).
V2_SCENARIO_CODE=scenario_9001

# v2 시나리오 JSON이 있는 **호스트** 디렉터리. 컨테이너에 read-only 마운트된다.
# 주의(GATE-f Q2): `:?`는 미설정만 막는다. 여기에 v1 시나리오 디렉터리를 넣으면
# v1 콘텐츠가 v2 DB에 시드되고 아무 에러도 나지 않는다. 값 내용은 운영자 책임이다.
V2_SCENARIO_HOST_DIR=/absolute/path/to/scenarios-v2

# v2 postgres 비밀번호. v1 크리덴셜 재사용 금지.
V2_POSTGRES_PASSWORD=change-me

# 기존 v1 gateway가 붙어 있는 external Docker network 이름. v2에서는 relay만 이 network에 attach한다.
# 기본 network 이름을 만들지 않으므로 실재 network 이름이 필수다.
SHARED_GATEWAY_NETWORK=replace-with-existing-v1-gateway-network

# existing v1 gateway의 unique DNS host:port. tracked local Compose의 container name은
# `opensamguk-gateway-api:8080`이다. `gateway-api:8080`는 v2 relay alias라 여기 쓰면 self-proxy가 된다.
SHARED_GATEWAY_UPSTREAM=opensamguk-gateway-api:8080

# 기존 v1 gateway-api가 쓰는 external profile-icons volume 이름. nginx가 같은 파일을 read-only로 제공한다.
SHARED_GATEWAY_PROFILE_ICONS_VOLUME=replace-with-existing-v1-profile-icons-volume

# v1 gateway-api가 발급한 토큰을 v2 game-api가 검증하는 X.509 DER 공개키(Base64).
JWT_PUBLIC_KEY=replace-with-existing-v1-gateway-public-key

# =====================================================================
# 2. 선택 — 미설정 시 아래 기본값이 쓰인다 (compose에 `:-` 로 박혀 있음)
# =====================================================================

# --- 데이터 계층 -------------------------------------------------------
V2_POSTGRES_DB=sammo_v2               # v2 전용 DB명. v1(`sammo`)과 절대 같게 두지 말 것
V2_POSTGRES_USER=sammo_v2             # v2 전용 DB 사용자
V2_POSTGRES_PORT=55432                # 호스트 노출 포트(비표준 — v1 5432와 충돌 회피)
V2_REDIS_PORT=56379                   # 호스트 노출 포트(비표준)

# --- 빌드/이미지 -------------------------------------------------------
V2_IMAGE_TAG=dev                      # `opensamguk-v2-sandbox/*` 이미지 태그

# --- 월드 정체성 (v1과 반드시 달라야 하는 값) ----------------------------
V2_WORLD_ID=9001                      # world 동일성. 불일치 시 ScenarioSeedCoordinator가 error()로 잡는다
V2_TURN_PROFILE_NAME=che:scenario_2   # 턴 프로파일(game-api OPENSAMGUK_PROFILE / engine TURN_PROFILE_NAME)
V2_SERVER_ID=v2s                      # 경로 serverId. `/game/<id>/...` rewrite 대상
V2_SERVER_NAME=v2 샌드박스             # 표시용 서버명
V2_SERVER_GENERATION=1                # 서버 세대

# --- 시나리오/시드 ------------------------------------------------------
V2_SCENARIO_DIR=/data/scenarios-v2    # 컨테이너 **안** 경로(V2_SCENARIO_HOST_DIR의 마운트 지점)
V2_SCENARIO_SEED_ENABLED=true         # v2 스택은 시드를 켠다. production compose의 false 불변식과 무관(계획 §2 C1)
# QA용 턴 주기 강제(빈값 = 미설정)
V2_SCENARIO_QA_TURNTERM=

# 리셋 옵션 — 빈값 그대로 두는 것이 기본이다. "미설정"의 의미는 SeedBootstrap이 소유하므로
# 여기서 기본값을 지어내지 않는다.
V2_RESET_TURNTERM=
V2_RESET_FICTION=
V2_RESET_EXTEND=
V2_RESET_BLOCK_GENERAL_CREATE=
V2_RESET_NPCMODE=
V2_RESET_SHOW_IMG_LEVEL=

# --- web-gateway 서버 레지스트리 -----------------------------------------
V2_SERVER_REGISTRY_JSON=[]            # web-gateway의 v2 게임 서버 레지스트리 JSON

# --- 관측 -------------------------------------------------------------
V2_SENTRY_DSN_GAME_API=
V2_SENTRY_DSN_GAME_ENGINE=
V2_SENTRY_ENVIRONMENT=v2-sandbox      # Sentry environment 태그

# --- 프론트 -----------------------------------------------------------
V2_NEXT_PUBLIC_GAME_URL=http://localhost:53001      # web-gateway 빌드 arg
V2_NEXT_PUBLIC_GATEWAY_URL=http://localhost:53000   # web-game 빌드 arg
V2_COOKIE_SECURE=false                              # 로컬 http면 false

# --- 호스트 노출 포트 (전부 비표준 — v1 스택과 동시 기동 전제) --------------
V2_GAME_API_PORT=58081
V2_GAME_ENGINE_PORT=58082
V2_WEB_GATEWAY_PORT=53000
V2_WEB_GAME_PORT=53001
V2_NGINX_HTTP_PORT=58090

# =====================================================================
# 3. 공유 gateway 경계와 compose가 의도적으로 공유하는 이름
# =====================================================================
# `SHARED_GATEWAY_NETWORK`은 relay만 붙는 필수 external network이고,
# `SHARED_GATEWAY_UPSTREAM`은 relay가 그 network에서 해석할 unique v1 gateway DNS host:port다.
# `SHARED_GATEWAY_PROFILE_ICONS_VOLUME`은 nginx가 read-only로 마운트하는 필수 external volume이다.
# `JWT_PUBLIC_KEY`는 v1 gateway-api의 공개 검증 키이며 v2 game-api에 서명 권한을 주지 않는다.
# 넷 모두 `V2_*` 기본값이나 ambient `.env` 상속으로 대체하지 않는다(s5 문서 §1.3 표).
#
#   TZ                       타임존. 호스트 단위 값 — v1과 달리 두면 로그 대조가 깨진다
#   NODE_ENV                 Next 런타임 모드
#   GAME_API_JAVA_OPTS       동上
#   GAME_ENGINE_JAVA_OPTS    동上

# =====================================================================
# 4. compose가 리터럴로 박아둔 값 (여기서 끌 수 없다)
# =====================================================================
#   V2_ENABLED=true                    게이트 조건 1 (game-api · game-engine · web-game)
#   SPRING_PROFILES_ACTIVE=v2-sandbox  게이트 조건 2 (game-api · game-engine)
#   SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration_v2
#     ↑ 치환이지 병합이 아니다. v1 location을 빼면 V1~V38이 통째로 사라진다(S0 실측).
#
# gateway-api는 v2 service가 아니다. v2 `gateway-api` alias는 relay에만 있고, relay upstream은 required
# `SHARED_GATEWAY_UPSTREAM`이다. sandbox가 계정 DB·admin seed·profile writer 또는 gateway Flyway migration을 만들지 않는다.
