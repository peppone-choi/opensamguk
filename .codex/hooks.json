{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/codex-session-start.sh\"",
            "async": false,
            "timeout": 180,
            "statusMessage": "Restoring OpenSamguk project skills"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/protect-sensitive-files.sh\"",
            "async": false,
            "timeout": 15,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/codex-bash-guard.sh\"",
            "async": false,
            "timeout": 15,
            "statusMessage": "Checking protected shell paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/codex-post-tool-use.sh\"",
            "async": false,
            "timeout": 30,
            "statusMessage": "Computing the verification matrix"
          }
        ]
      }
    ]
  }
}
