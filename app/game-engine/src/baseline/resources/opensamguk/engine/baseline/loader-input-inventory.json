{
  "schemaVersion": "cqrs-loader-input-inventory.v2",
  "payloadByteSemantics": "selected-loader-fields-postgres-text-bytes.v1",
  "inputs": [
    {"id": "worldState", "source": "world_state WHERE id = ?", "retainedAs": "TurnWorldState", "loaderColumns": ["id", "current_year", "current_month", "current_phase", "tick_seconds", "isunited", "status", "meta", "config", "start_time", "world_version", "writer_epoch"], "payloadColumns": ["id", "current_year", "current_month", "current_phase", "tick_seconds", "isunited", "status", "meta", "config", "start_time", "world_version", "writer_epoch"]},
    {"id": "ngGames", "source": "countQuery=SELECT count(*) AS source_rows, octet_length((count(*))::text) AS payload_bytes FROM ng_games | activeQuery=SELECT id, server_id, season, scenario, scenario_name, map, CAST(env AS VARCHAR) AS env FROM ng_games WHERE server_id = ?", "retainedAs": "state.meta.serverCount plus optional active game", "loaderColumns": ["server_count", "id", "server_id", "season", "scenario", "scenario_name", "map", "env"], "payloadColumns": ["server_count", "id", "server_id", "season", "scenario", "scenario_name", "map", "env"]},
    {"id": "archivedNationIds", "source": "ng_old_nations scoped by active server", "retainedAs": "WorldSnapshot.archivedNationIds", "loaderColumns": ["nation"], "payloadColumns": ["nation"]},
    {"id": "statistics", "source": "statistic", "retainedAs": "state.meta.statisticRows", "loaderColumns": ["id", "nation_count", "nation_name", "nation_hist", "gen_count", "personal_hist", "special_hist", "aux"], "payloadColumns": ["id", "nation_count", "nation_name", "nation_hist", "gen_count", "personal_hist", "special_hist", "aux"]},
    {"id": "nationHistoryLogs", "source": "log_entry scope=NATION category=HISTORY", "retainedAs": "state.meta.nationHistory", "loaderColumns": ["nation_id", "text"], "payloadColumns": ["text"]},
    {"id": "generalHistoryLogs", "source": "log_entry scope=GENERAL category=HISTORY", "retainedAs": "state.meta.generalHistory", "loaderColumns": ["general_id", "text"], "payloadColumns": ["text"]},
    {"id": "systemActionLogs", "source": "log_entry scope=SYSTEM category=ACTION", "retainedAs": "state.meta.globalLogs", "loaderColumns": ["category", "year", "month", "text"], "payloadColumns": ["text"]},
    {"id": "systemHistoryLogs", "source": "log_entry scope=SYSTEM category=HISTORY", "retainedAs": "state.meta.globalLogs", "loaderColumns": ["category", "year", "month", "text"], "payloadColumns": ["text"]},
    {"id": "activeUniqueAuctionItems", "source": "ng_auction active uniqueItem", "retainedAs": "state.meta.activeUniqueAuctionItems", "loaderColumns": ["target"], "payloadColumns": ["target"]},
    {"id": "storedUniqueItemNamespaces", "source": "game_kv namespace ut_*", "retainedAs": "state.meta.storedUniqueItemCounts", "loaderColumns": ["namespace", "cnt"], "payloadColumns": ["namespace", "cnt"]},
    {"id": "gameEnv", "source": "game_kv game_env namespaces", "retainedAs": "TurnWorldState.meta", "loaderColumns": ["key", "value_json"], "payloadColumns": ["key", "value_json"]},
    {"id": "nationEnv", "source": "nation_env", "retainedAs": "Nation.meta.nation_env", "loaderColumns": ["namespace", "key", "value_json"], "payloadColumns": ["namespace", "key", "value_json"]},
    {"id": "inheritancePoints", "source": "game_kv inheritance namespaces", "retainedAs": "state.meta.inheritancePoints", "loaderColumns": ["namespace", "key", "value_json"], "payloadColumns": ["namespace", "key", "value_json"]},
    {"id": "generalRankValues", "source": "rank_data", "retainedAs": "TurnGeneral.meta rank values", "loaderColumns": ["general_id", "type", "value"], "payloadColumns": ["general_id", "type", "value"]},
    {"id": "nations", "source": "nation WHERE world_id = ?", "retainedAs": "WorldSnapshot.nations", "loaderColumns": ["id", "name", "color", "capital_city_id", "gold", "rice", "tech", "power", "level", "type_code", "meta"], "payloadColumns": ["id", "name", "color", "capital_city_id", "gold", "rice", "tech", "power", "level", "type_code", "meta"]},
    {"id": "cities", "source": "city WHERE world_id = ?", "retainedAs": "WorldSnapshot.cities", "loaderColumns": ["id", "name", "nation_id", "level", "state", "supply_state", "front_state", "pop", "pop_max", "dead", "agri", "agri_max", "comm", "comm_max", "secu", "secu_max", "trust", "def", "def_max", "wall", "wall_max", "trade", "region", "term", "officer_set", "conflict", "meta"], "payloadColumns": ["id", "name", "nation_id", "level", "state", "supply_state", "front_state", "pop", "pop_max", "dead", "agri", "agri_max", "comm", "comm_max", "secu", "secu_max", "trust", "def", "def_max", "wall", "wall_max", "trade", "region", "term", "officer_set", "conflict", "meta"]},
    {"id": "generals", "source": "general WHERE world_id = ?", "retainedAs": "WorldSnapshot.generals", "loaderColumns": ["id", "name", "nation_id", "city_id", "troop_id", "npc_state", "affinity", "leadership", "strength", "intel", "politics", "charm", "experience", "dedication", "officer_level", "injury", "gold", "rice", "crew", "crew_type_id", "train", "atmos", "age", "weapon_code", "book_code", "horse_code", "item_code", "turn_time", "recent_war_time", "user_id", "born_year", "dead_year", "picture", "image_server", "start_age", "personal_code", "special_code", "special2_code", "officer_city", "last_turn", "penalty", "meta"], "payloadColumns": ["id", "name", "nation_id", "city_id", "troop_id", "npc_state", "affinity", "leadership", "strength", "intel", "politics", "charm", "experience", "dedication", "officer_level", "injury", "gold", "rice", "crew", "crew_type_id", "train", "atmos", "age", "weapon_code", "book_code", "horse_code", "item_code", "turn_time", "recent_war_time", "user_id", "born_year", "dead_year", "picture", "image_server", "start_age", "personal_code", "special_code", "special2_code", "officer_city", "last_turn", "penalty", "meta"]},
    {"id": "diplomacy", "source": "diplomacy", "retainedAs": "WorldSnapshot.diplomacy", "loaderColumns": ["src_nation_id", "dest_nation_id", "state_code", "term", "is_dead", "meta"], "payloadColumns": ["src_nation_id", "dest_nation_id", "state_code", "term", "is_dead", "meta"]},
    {"id": "generalAccessLogs", "source": "general_access_log", "retainedAs": "WorldSnapshot.accessLogs", "loaderColumns": ["general_id", "user_id", "last_refresh", "refresh", "refresh_total", "refresh_score", "refresh_score_total"], "payloadColumns": ["general_id", "user_id", "last_refresh", "refresh", "refresh_total", "refresh_score", "refresh_score_total"]}
  ]
}
