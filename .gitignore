# Gradle / JVM
.gradle/
# Python bytecode (tools/rtk14 등 스크립트)
__pycache__/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
# IDE
.idea/
*.iml
.vscode/
# Node / Next.js
node_modules/
web/*/.next/
web/*/out/
.pnpm-store/
# Env / OS
.env*
!.env*.example
.env.headroom.example
.DS_Store
# Local headroom/docker overrides
docker-compose.headroom.yml
# Legacy reference repos (kept locally, never committed)
legacy/
# Decompiled / generated artifacts
**/generated/
# Local workflow orchestration scripts (transient tooling)
.workflow-*.mjs
# Local wiki knowledge base
docs/wiki/
# Throwaway PHP golden investigation scripts
tools/php-golden/probe_*.php
# Playwright MCP temp dir
.playwright-mcp/
# Temporary research dir
.tmp_research/
**/tsconfig.tsbuildinfo

.claude/scheduled_tasks.lock

# OMC / agent session state (local, never commit)
.omc/
web/*/.omc/

# Agent worktree/team scratch trees (local orchestration state, never
# committed). #513 이 .git/info/exclude 에만 있던 걸 여기로 올렸다 — 그때 근거는
# check.py 의 product-authority 스캔이었고 그 스크립트는 #547 에서 지워졌지만,
# 규칙 자체는 살린다: 이걸 빼면 .omo/·.omx/·.codegraph 가 그냥 커밋 가능해진다.
.omo/
.omx/
.codegraph
# graphify cache output — #513 실측상 ignore 규칙이 아예 없어서 untracked 로
# 남아 있었다. 생성물이라 커밋 대상이 아니다.
common/src/main/kotlin/graphify-out/

# Local scratch directories
parity-shots/
tmp/

# Playwright 실행 산출물
web/*/test-results/

# 감사 raw 스크래치(대용량, working dir 보존)
docs/superpowers/gap/_*.raw.json

# RTK14(삼국지14) 무장 스탯 = 코에이 IP, 절대 커밋 금지 (정치/매력 divergence 소스)
**/rtk14_stats.local.json
**/scenario_*.local.json
**/rtk14-scenarios.local/
data/scenarios/scenario_*.json
data/scenario-source/
data/scenarios/refined/
data/scenarios/reports/

# CHGIS/TGAZ (ADR-LITE-039) — 사용은 허용, 재배포 금지. 원본·파생 좌표 데이터 미커밋.
# 커밋되는 것은 tools/map/*.py 추출 스크립트뿐이다.
data/chgis-source/
# 파생 좌표·격자·계층 전부 미커밋. 커밋되는 것은 tools/map/*.py 뿐이다.
data/map/*
# ADR-LITE-040: 게임이 서빙하는 타일맵만 예외. 원본·중간 산출물은 계속 미커밋.
!data/map/han-tiles.json
# Wikidata(CC0) 전용 산출물, CHGIS 입력 없음 — CHGIS 파생물이 아니므로 위 미커밋 규칙 대상이 아니다.
# tools/map/build_external_places.py docstring 참조. han-places.json/terrain-grid.json 은 계속 미커밋.
!data/map/external-places.json
**/v6_*_pts*
**/v6_*_pgn*
**/v6_*_lin*
**/tgaz_*

# 사료 코퍼스 — zh.wikisource(PD) 원문·파생 인덱스는 미커밋.
# tools/corpus/fetch_sources.py 로 언제든 재현된다. 커밋 대상은 tools/corpus/*.py 뿐이다.
data/corpus/
data/natural-earth/
data/modern-admin/
