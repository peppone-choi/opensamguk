# Agent worktree/team scratch trees (local orchestration state, never
# committed — #513: previously only .git/info/exclude, which check.py's
# `git ls-files --others --exclude-standard` doesn't see, so an untracked
# .omo/ leaked into the product-authority scan on machines that have one).
# .omx/ and .codegraph had the same local-only-exclude gap (verified via
# `git check-ignore -v`: both resolved to .git/info/exclude, not .gitignore,
# on the checkout #513 was measured on).
.omo/
.omx/
.codegraph
# graphify cache output (verified untracked AND unignored on the #513
# checkout — `git check-ignore -v` found no match at all, so it was leaking
# into `git ls-files --others` too; harmless today only because it's all
# .json, but it's generated output and shouldn't be scanned or committable).
common/src/main/kotlin/graphify-out/

# Local scratch directories
parity-shots/
tmp/

# superpowers brainstorm 런타임 상태(pid/token) + Playwright 실행 산출물
.superpowers/
web/*/test-results/

# 감사 raw 스크래치(대용량, working dir 보존)
docs/superpowers/gap/_*.raw.json

