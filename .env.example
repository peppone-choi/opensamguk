# ==========================================================================
# opensamguk — turnkey env (LOCAL dev defaults). Copy to `.env`:
#
#     cp .env.example .env && docker compose up --build
#
# Every value below is a SAFE LOCAL DEV DEFAULT or placeholder — NO real
# secrets. On the server, override these (a real JWT key pair, a strong
# POSTGRES_PASSWORD, https NEXT_PUBLIC_* origins, GHCR image coords) via the
# server's own `.env` and docker-compose.production.yml. Never commit real
# secrets to this file.
# ==========================================================================

# --------------------------------------------------------------------------
# Database (postgres) — shared by gateway-api, board-api, game-api, game-engine
# --------------------------------------------------------------------------
POSTGRES_DB=sammo
POSTGRES_USER=sammo
POSTGRES_PASSWORD=sammo
POSTGRES_PORT=5432
TZ=Asia/Seoul
# JDBC URL the JVM services use to reach postgres. Inside compose the host is
# the service name `postgres`; compose builds this from POSTGRES_* above, so
# you normally do NOT set GAME_DATABASE_URL here. Override only for an external DB.
# GAME_DATABASE_URL=jdbc:postgresql://postgres:5432/sammo
# GAME_DB_USER / GAME_DB_PASSWORD mirror POSTGRES_USER / POSTGRES_PASSWORD.

# --------------------------------------------------------------------------
# Redis — XADD intake bus + cache (gateway-api, game-api, game-engine)
# --------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------------------------------
# JWT — gateway-api alone receives the Base64 PKCS#8 RSA private key. game-api and
# board-api receive only the matching Base64 X.509 public key. Generate both without
# writing an unencrypted PEM into the repository:
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#     openssl pkcs8 -topk8 -nocrypt -in jwt-private.pem -outform DER | openssl base64 -A
#     openssl pkey -in jwt-private.pem -pubout -outform DER | openssl base64 -A
# Delete jwt-private.pem after placing the values in the untracked local/production env.
# --------------------------------------------------------------------------
# 아래 두 줄은 자리표시자다. docker-compose 의 ${JWT_*_KEY:?} 가드는 unset 뿐 아니라
# 빈 값도 거부하므로, 템플릿이 비어 있으면 compose 그래프 자체가 해석되지 않는다.
# 이 값은 유효한 키가 아니라서 그대로 두면 부팅이 즉시 실패한다 — 위 openssl 명령으로 교체하라.
JWT_PRIVATE_KEY=changeme-generate-with-openssl-see-above
JWT_PUBLIC_KEY=changeme-generate-with-openssl-see-above
JWT_SIGNING_MODE=RS256
JWT_INCLUDE_PROFILE_CLAIMS=true
# Stage 1 rollout only. All three values must be set together, with absolute UTC cutoffs.
JWT_LEGACY_SECRET=
JWT_LEGACY_ACCESS_ACCEPT_UNTIL=
JWT_LEGACY_REFRESH_ACCEPT_UNTIL=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --------------------------------------------------------------------------
# gateway-api (:8080) — auth / profile / admin seed
# --------------------------------------------------------------------------
GATEWAY_API_PORT=8080
# AdminSeeder creates this ADMIN account on first boot (empty users table) and
# is idempotent thereafter. Set a strong local secret; blank either value to skip seeding.
ADMIN_USERNAME=peppone
ADMIN_PASSWORD=
# Server registry runtime source of truth is the `game_server` table (ServerRegistry.kt
# reads it per-request, no restart needed). This value is used ONLY as a one-time seed
# when that table is empty (seedEmptyRegistry()) — it is not consulted after that.
SERVER_REGISTRY_JSON=[]
# Admin deployer sidecar/client. Leave blank for local UI-only runs; set both in production
# when using admin server/env/version controls. Generate a strong token on the server.
DEPLOYER_URL=
DEPLOYER_TOKEN=
# JVM tuning (optional)
GATEWAY_API_JAVA_OPTS=-XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
BOARD_API_PORT=8083
BOARD_API_JAVA_OPTS=-XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom

# --------------------------------------------------------------------------
# game-api (:8081) — read / precheck / intake / SSE
# --------------------------------------------------------------------------
GAME_API_PORT=8081
GAME_API_JAVA_OPTS=-XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
OPENSAMGUK_WORLD_ID=1

# --------------------------------------------------------------------------
# game-engine (:8082) — turn daemon + scenario seed
# --------------------------------------------------------------------------
GAME_ENGINE_PORT=8082
# Turn profile: "<server>:<scenario>" consumed by game-api (OPENSAMGUK_PROFILE)
# and game-engine (TURN_PROFILE_NAME).
# ADR-LITE-043 retired scenario default — code-parity concern, kept as-is (changing the
# value here without matching the code default breaks boot).
TURN_PROFILE_NAME=che:scenario_2
# ScenarioSeedRunner seeds a fresh/empty DB into a playable world (idempotent —
# gated on world_state emptiness). The bundled scenario_1010 has 678 generals.
SCENARIO_SEED_ENABLED=true
SCENARIO_CODE=scenario_1010
# Optional external scenario directory. Files here override bundled scenarios
# by original filename; generated RTK14 politics/charm data stays gitignored.
SCENARIO_DIR=/data/scenarios
SCENARIO_HOST_DIR=./data/scenarios
# 어드민/워크플로 리셋이 고른 시나리오 옵션. 비워두면(미설정) SeedBootstrap이
# PHP install.php 기본값을 쓴다 — 여기에 기본 숫자를 적지 말 것(정본이 갈라진다).
RESET_TURNTERM=
RESET_FICTION=
RESET_EXTEND=
RESET_BLOCK_GENERAL_CREATE=
RESET_NPCMODE=
RESET_SHOW_IMG_LEVEL=
GAME_ENGINE_JAVA_OPTS=-XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom

# --------------------------------------------------------------------------
# web/gateway (:3000) — Next.js landing + auth
# --------------------------------------------------------------------------
WEB_GATEWAY_PORT=3000
# Server-only: route handlers proxy to gateway-api. NOT exposed to the browser.
# Inside compose use the service DNS name; for host-run dev use http://localhost:8080.
GATEWAY_API_URL=http://gateway-api:8080
BOARD_API_URL=http://board-api:8083
# Server-only fallback used by the /api/game Next proxy when no per-server registry entry is selected.
GAME_API_ORIGIN=http://game-api:8081
# BUILD-time public: the game front entry URL the lobby "enter" link points at.
# Inlined into the client bundle at build (compose passes it as a build arg).
NEXT_PUBLIC_GAME_URL=http://localhost:3001

# --------------------------------------------------------------------------
# web/game (:3001) — Next.js game client
# --------------------------------------------------------------------------
WEB_GAME_PORT=3001
# Server-only: route handlers proxy to game-api. NOT exposed to the browser.
GAME_API_URL=http://game-api:8081
# (GATEWAY_API_URL above is shared — web/game also proxies /api/auth/me to it.)
# BUILD-time public: gateway front ORIGIN for the cross-app login redirect.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000

# 이미지 자산 CDN 베이스 (opensamguk-images jsDelivr 미러). 선택 — 미설정 시 기본값 사용.
# 맵·포트레이트·3D 등 모든 이미지 참조가 이 베이스를 쓴다(web/game·web/gateway lib/constants.ts).
NEXT_PUBLIC_IMAGE_CDN=https://cdn.jsdelivr.net/gh/peppone-choi/opensamguk-images

# --------------------------------------------------------------------------
# Sentry — 프론트 2앱(web/gateway·web/game) + 백엔드 4앱(gateway-api·board-api·game-api·game-engine)
# 에러 관측. 전부 선택값: DSN 미설정이면 SDK 전체가 no-op (로컬 dev 기본). DSN은 시크릿이
# 아니라 수집 엔드포인트지만, 값은 서버 .env에서만 관리한다.
# --------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=            # 브라우저+서버 공용 DSN (앱별로 다르면 각 앱 .env에)
# SENTRY_DSN=                        # 서버 전용 DSN (미설정 시 NEXT_PUBLIC_ 값 사용)
# SENTRY_ORG=                        # 소스맵 업로드용 (SENTRY_AUTH_TOKEN 있을 때만 사용)
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=                 # 빌드타임 소스맵 업로드 토큰 — 미설정이면 업로드 생략(백로그)
# 백엔드 4앱은 에러 캡처 전용(traces-sample-rate 0 고정 — 턴 데몬 핫루프에 트레이싱 미탑재).
# 서비스별 DSN → compose가 각 컨테이너의 SENTRY_DSN으로 매핑(한 프로젝트로 모으려면 같은 값).
# SENTRY_DSN_GATEWAY_API=
# SENTRY_DSN_BOARD_API=
# SENTRY_DSN_GAME_API=
# SENTRY_DSN_GAME_ENGINE=
# SENTRY_ENVIRONMENT=                # Sentry environment 태그 (로컬 기본 local, prod compose 기본 production)

# --------------------------------------------------------------------------
# Shared web runtime
# --------------------------------------------------------------------------
NODE_ENV=production
# Session-cookie Secure flag — INDEPENDENT of NODE_ENV. Leave false for plain-HTTP access
# (local/LAN docker compose on :80/:3000): a Secure cookie over HTTP is dropped by the browser, so
# login would silently bounce back to /login. Set true ONLY when serving over HTTPS.
COOKIE_SECURE=false

# --------------------------------------------------------------------------
# nginx reverse proxy (:80) — same-origin routing (infra/nginx/nginx.conf)
# --------------------------------------------------------------------------
NGINX_HTTP_PORT=80

# --------------------------------------------------------------------------
# Production-only image coordinates (docker-compose.production.yml).
# Unused locally (local compose BUILDS from docker/*.Dockerfile).
# --------------------------------------------------------------------------
# GHCR_REGISTRY=ghcr.io
# GHCR_OWNER=opensamguk
# IMAGE_TAG=latest
